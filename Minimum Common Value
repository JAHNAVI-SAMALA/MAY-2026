class Solution:
    def getCommon(self, nums1: List[int], nums2: List[int]) -> int:
        i = j = 0
        while i < len(nums1) and j < len(nums2):
                if nums1[i] == nums2[j]:
                    return nums1[i]
                if nums1[i] < nums2[j]:
                    i += 1
                else:
                    j += 1
        return -1


class Solution:
    def getCommon(self, nums1: List[int], nums2: List[int]) -> int:
        s = set(nums1)
        for num in nums2:
            if num in s:
                return num
        return -1
