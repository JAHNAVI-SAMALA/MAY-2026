from collections import defaultdict, deque

class Solution:
    def minJumps(self, arr: List[int]) -> int:
        n = len(arr)

        if n == 1:
            return 0

        mp = defaultdict(list)

        for i, v in enumerate(arr):
            mp[v].append(i)

        q = deque([0])

        visited = [False] * n
        visited[0] = True

        steps = 0

        while q:

            for _ in range(len(q)):

                i = q.popleft()

                if i == n - 1:
                    return steps

                neighbors = [i - 1, i + 1] + mp[arr[i]]

                for nei in neighbors:

                    if 0 <= nei < n and not visited[nei]:

                        visited[nei] = True
                        q.append(nei)

                mp[arr[i]].clear()

            steps += 1
