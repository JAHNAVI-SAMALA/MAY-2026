class Solution:
    def minMoves(self, nums: List[int], limit: int) -> int:
        n = len(nums)
        delta = [0] * (2 * limit + 2)

        for i in range(n // 2):
            a = nums[i]
            b = nums[n - 1 - i]

            low = min(a, b) + 1
            high = max(a, b) + limit
            s = a + b

            delta[2] += 2
            delta[2 * limit + 1] -= 2

            delta[low] -= 1
            delta[high + 1] += 1

            delta[s] -= 1
            delta[s + 1] += 1

        ans = float('inf')
        cur = 0

        for i in range(2, 2 * limit + 1):
            cur += delta[i]
            ans = min(ans, cur)

        return ans