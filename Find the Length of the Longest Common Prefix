class Solution:
    def longestCommonPrefix(self, arr1: List[int], arr2: List[int]) -> int:
        prefixes = set()

        for x in arr1:
            while x > 0:
                prefixes.add(x)
                x //= 10

        ans = 0

        for y in arr2:
            temp = y

            while temp > 0:
                if temp in prefixes:
                    ans = max(ans, len(str(temp)))
                    break
                temp //= 10

        return ans